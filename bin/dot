#!/usr/bin/env bash
# Wrapper around mise for this repo's dotfiles. Works from any directory, before
# or after ~/.config/mise/config.toml is linked.
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export MISE_GLOBAL_CONFIG_FILE="$repo/mise/config.toml"
export MISE_TRUSTED_CONFIG_PATHS="$repo${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"

# Without a token GitHub allows only 60 API requests an hour, which `outdated`
# and `upgrade` exceed. Take it from gh, but never through the ~/.local/bin/gh
# wrapper or a mise shim: both call back into mise, which can recurse. Don't use
# mise's github.credential_command for this, for the same reason.
if [ -z "${MISE_GITHUB_TOKEN:-}${GITHUB_TOKEN:-}" ]; then
  # `mise which` only looks the path up, so it works without mise activated;
  # the PATH search covers a gh that mise doesn't manage (e.g. brew or pacman)
  # stock macOS has no timeout(1), so only use it when present. The ${a[@]+...}
  # form is for macOS's bash 3.2, where an empty array is unbound under set -u
  timeout_cmd=(); command -v timeout >/dev/null && timeout_cmd=(timeout 5)
  while IFS= read -r gh_bin; do
    case "$gh_bin" in ''|"$HOME"/.local/bin/*|*/mise/shims/*) continue ;; esac
    if MISE_GITHUB_TOKEN=$(${timeout_cmd[@]+"${timeout_cmd[@]}"} "$gh_bin" auth token 2>/dev/null) && [ -n "$MISE_GITHUB_TOKEN" ]; then
      export MISE_GITHUB_TOKEN
      break
    fi
    unset MISE_GITHUB_TOKEN
  done < <(mise which gh 2>/dev/null; type -ap gh)
fi

usage() {
  cat <<EOF
Usage: dot <command> [args]

Commands:
  setup     Install and update everything: packages, dotfiles, tools
            (pass --dry-run to preview)
  login-shell
            Make fish your login shell (asks for your password)
  mounts    Linux only: mount the diskstation SMB shares (~/ds, ~/public) via
            /etc/fstab; uses sudo and asks for credentials if not yet saved
            (pass --dry-run to preview)
  hibernate Linux only: add a btrfs swapfile and make closing the lid suspend,
            then hibernate after 30 minutes; uses sudo (pass --dry-run to preview)
  fingerprint
            Linux only: let polkit prompts (1Password unlock) take a
            fingerprint; uses sudo (pass --dry-run to preview)
  trust     Trust this repo's mise config (setup does this too)
  status    Show what is out of sync with the dotfiles config
  diff      Show the dotfile changes setup would make
  outdated  Show tools that have updates
  help      Show this list
EOF
}

trust() { env -u MISE_GLOBAL_CONFIG_FILE -u MISE_TRUSTED_CONFIG_PATHS mise trust "$repo/mise/config.toml"; }

login_shell() {
  local fish
  fish=$(command -v fish) || { echo "dot: fish is not installed (run dot setup)" >&2; exit 1; }
  grep -qx "$fish" /etc/shells || echo "$fish" | sudo tee -a /etc/shells >/dev/null
  chsh -s "$fish"
}

mounts() {
  if [ "$(uname -s)" != Linux ]; then
    echo "dot: mounts is Linux only" >&2
    exit 1
  fi
  local dry=0 creds=/etc/samba/credentials.d/diskstation snippet="$repo/linux/fstab-smb"
  [ "${1:-}" = --dry-run ] && dry=1
  run() { if [ $dry -eq 1 ]; then echo "would run: $*"; else "$@"; fi; }

  command -v mount.cifs >/dev/null || run sudo pacman -S --needed cifs-utils

  local line mountpoint
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    mountpoint=$(awk '{print $2}' <<<"$line")
    run mkdir -p "$mountpoint"
    if awk -v mp="$mountpoint" '$1 !~ /^#/ && $2 == mp {found=1} END {exit !found}' /etc/fstab; then
      echo "dot: $mountpoint already in /etc/fstab"
    elif [ $dry -eq 1 ]; then
      echo "would append to /etc/fstab: $line"
    else
      echo "$line" | sudo tee -a /etc/fstab >/dev/null
    fi
  done <"$snippet"

  if [ $dry -eq 1 ]; then
    echo "would write $creds (mode 600) after prompting for username/password, unless it exists"
  elif sudo test -f "$creds"; then
    echo "dot: $creds exists"
  else
    local user pass
    read -rp "diskstation username: " user
    read -rsp "diskstation password: " pass; echo
    sudo install -d -m 755 "$(dirname "$creds")"
    printf 'username=%s\npassword=%s\n' "$user" "$pass" | sudo install -m 600 -o root -g root /dev/stdin "$creds"
  fi

  run sudo systemctl daemon-reload
  run sudo systemctl restart remote-fs.target
}

hibernate() {
  if [ "$(uname -s)" != Linux ]; then
    echo "dot: hibernate is Linux only" >&2
    exit 1
  fi
  local dry=0
  [ "${1:-}" = --dry-run ] && dry=1
  run() { if [ $dry -eq 1 ]; then echo "would run: $*"; else "$@"; fi; }
  append_fstab() {
    if [ $dry -eq 1 ]; then echo "would append to /etc/fstab: $1"
    else echo "$1" | sudo tee -a /etc/fstab >/dev/null; fi
  }

  # zram swap is lost on power off, so hibernation needs a swapfile on disk. It
  # lives in its own top-level @swap subvolume so snapper snapshots of @ skip it
  local uuid
  uuid=$(findmnt -no UUID /)
  [ "$(findmnt -no FSTYPE /)" = btrfs ] || { echo "dot: / is not btrfs" >&2; exit 1; }
  if grep -q 'subvol=/@swap' /etc/fstab; then
    echo "dot: /swap already in /etc/fstab"
  else
    local top
    top=$(mktemp -d)
    run sudo mount -o subvolid=5 "UUID=$uuid" "$top"
    if [ $dry -eq 1 ] || ! sudo test -d "$top/@swap"; then run sudo btrfs subvolume create "$top/@swap"; fi
    run sudo umount "$top"
    rmdir "$top"
    run sudo mkdir -p /swap
    append_fstab "UUID=$uuid /swap          btrfs   subvol=/@swap,defaults,noatime 0 0"
    run sudo systemctl daemon-reload
    run sudo mount /swap
  fi

  # RAM size plus headroom; mkswapfile sets nocow and disables compression
  local size_g
  size_g=$(awk '/^MemTotal:/ {print int($2 / 1048576) + 3}' /proc/meminfo)
  if [ -f /swap/swapfile ]; then
    echo "dot: /swap/swapfile exists"
  else
    run sudo btrfs filesystem mkswapfile --size "${size_g}g" /swap/swapfile
  fi
  if grep -q '^/swap/swapfile' /etc/fstab; then
    echo "dot: /swap/swapfile already in /etc/fstab"
  else
    append_fstab "/swap/swapfile                            none           swap    defaults 0 0"
  fi
  swapon --show=NAME --noheadings | grep -qx /swap/swapfile || run sudo swapon /swap/swapfile

  run sudo install -Dm644 "$repo/linux/systemd/sleep.conf.d/hibernate-delay.conf" /etc/systemd/sleep.conf.d/hibernate-delay.conf
  run sudo install -Dm644 "$repo/linux/systemd/logind.conf.d/lid.conf" /etc/systemd/logind.conf.d/lid.conf
  # HUP reloads logind's config; restarting it would end the session
  run sudo systemctl kill -s HUP systemd-logind
}

fingerprint() {
  if [ "$(uname -s)" != Linux ]; then
    echo "dot: fingerprint is Linux only" >&2
    exit 1
  fi
  local dry=0
  [ "${1:-}" = --dry-run ] && dry=1
  run() { if [ $dry -eq 1 ]; then echo "would run: $*"; else "$@"; fi; }

  # /etc/pam.d overrides the package's /usr/lib/pam.d/polkit-1
  run sudo install -Dm644 "$repo/linux/pam.d/polkit-1" /etc/pam.d/polkit-1
  fprintd-list "$USER" 2>/dev/null | grep -q ' - #' ||
    echo "dot: no fingerprints enrolled yet; run fprintd-enroll"
}

# A fresh CachyOS install copies stock niri and noctalia configs from /etc/skel,
# which mise refuses to replace. Remove them, but only while they still match
# /etc/skel exactly, so nothing edited is lost.
remove_stock_configs() {
  local dry=0 path
  [ "${1:-}" = --dry-run ] && dry=1
  for path in .config/niri .config/noctalia/config.toml; do
    [ -e "$HOME/$path" ] && [ ! -L "$HOME/$path" ] && [ -e "/etc/skel/$path" ] || continue
    diff -r "/etc/skel/$path" "$HOME/$path" >/dev/null || continue
    if [ $dry -eq 1 ]; then
      echo "would remove stock ~/$path (same as /etc/skel)"
    else
      echo "dot: removing stock ~/$path (same as /etc/skel)"
      rm -rf "${HOME:?}/$path"
    fi
  done
}

setup() {
  local a dry=()
  for a in "$@"; do [ "$a" = --dry-run ] && dry=(--dry-run); done
  remove_stock_configs ${dry[@]+"${dry[@]}"}
  mise bootstrap "$@"
  # "latest" is satisfied by whatever is installed, so bootstrap never upgrades
  mise upgrade ${dry[@]+"${dry[@]}"}
  # register herdr's local plugin once the dotfiles are linked; mise which works
  # even when mise isn't activated in this shell
  local herdr
  if [ ${#dry[@]} -eq 0 ] && herdr=$(mise which herdr 2>/dev/null || command -v herdr); then
    "$herdr" plugin link ~/.config/herdr/plugins/default-layout >/dev/null || echo "dot: herdr plugin link failed" >&2
  fi
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  setup)    trust; setup "$@" ;;
  trust)    trust ;;
  login-shell) login_shell ;;
  mounts)   mounts "$@" ;;
  hibernate) hibernate "$@" ;;
  fingerprint) fingerprint "$@" ;;
  status)   mise bootstrap status "$@" ;;
  diff)     mise dotfiles diff "$@" ;;
  outdated) mise outdated "$@" ;;
  help|-h|--help) usage ;;
  *) echo "dot: unknown command '$cmd'" >&2; usage >&2; exit 1 ;;
esac
